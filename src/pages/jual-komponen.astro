---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getAllData } from '../lib/data';

const { jual } = await getAllData();
---

<Layout title="Jual Komponen Elektronik Industri | Alfa Elektrindo" description="Penawaran spesial untuk berbagai komponen elektronik industri dan spare part pabrikasi.">
  <PageHeader
    eyebrow={`Ref: ALFA-DOC / SPECIAL-OFFERS`}
    title={`Special`}
    titleAccent={`Offers`}
    description="Penawaran khusus untuk stok komponen elektronik industri terbaik dengan harga kompetitif."
  >
    <div slot="meta" class="flex flex-wrap gap-x-8 gap-y-3 border-t border-white/10 pt-6 mt-8 font-mono text-[11px] uppercase tracking-widest text-gray-400">
      <span>Available: <span class="text-white font-bold">{jual.length}</span></span>
    </div>
  </PageHeader>

  <section class="py-16 bg-paper">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {jual.map(item => (
          <a href={`/jual/${item.slug}`} class="hard-card group flex flex-col md:flex-row rounded-lg overflow-hidden transition-all duration-300 hover:border-primary">
            <div class="md:w-1/3 aspect-square bg-gray-100">
              <img 
                src={item.fifu_image_url || '/placeholder-jual.png'} 
                alt={item.long_title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-8 flex-1 flex flex-col justify-between">
              <h3 class="text-lg font-mono font-bold text-navy mb-4 group-hover:text-primary transition-colors leading-tight">
                {item.long_title}
              </h3>
              <div class="text-[10px] font-mono text-primary font-bold uppercase tracking-widest flex items-center">
                Lihat Penawaran <span class="ml-2 text-xl">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>