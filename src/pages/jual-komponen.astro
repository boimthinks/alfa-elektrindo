---
import Layout from '../layouts/Layout.astro';
import { getAllData } from '../lib/api';

const { jual } = await getAllData();
---

<Layout title="Jual Komponen Elektronik Industri | Alfa Elektrindo" description="Penawaran spesial untuk berbagai komponen elektronik industri dan spare part pabrikasi.">
  <div class="bg-gray-900 py-16 text-white text-center">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold mb-4">Jual Komponen Elektronik</h1>
      <p class="text-gray-400 max-w-2xl mx-auto">
        Penawaran khusus untuk stok komponen elektronik industri terbaik dengan harga kompetitif.
      </p>
    </div>
  </div>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {jual.map(item => (
          <a href={`/jual/${item.slug}`} class="group flex flex-col md:flex-row bg-gray-50 rounded-3xl overflow-hidden hover:shadow-xl transition-all border border-gray-100">
            <div class="md:w-1/3 aspect-square bg-gray-200">
              <img 
                src={item.fifu_image_url || '/placeholder-jual.png'} 
                alt={item.long_title}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              />
            </div>
            <div class="p-8 flex-1 flex flex-col justify-center">
              <h3 class="text-xl font-bold text-gray-900 mb-4 group-hover:text-primary transition-colors">
                {item.long_title}
              </h3>
              <div class="text-primary font-bold flex items-center">
                Lihat Penawaran <span class="ml-2">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
