  return pagesData.map(({ slug, title, intro, sections }) => ({
    params: { slug },
    props: { title, intro, sections }
  }));
}

const { title, intro, sections } = Astro.props;
---

<Layout title={`${title} | Alfa Elektrindo`}>
  <div class="bg-navy py-20 text-white relative border-b-4 border-[#007aff]">
    <div class="container mx-auto px-4 relative z-10">
      <span class="font-mono text-[10px] tracking-widest text-accent uppercase">ref. 2026-ALFA-DOC</span>
      <h1 class="text-5xl font-black mt-4 uppercase tracking-tighter font-mono">{title}</h1>
    </div>
  </div>

  <section class="py-20 bg-paper">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="hard-card p-10 md:p-14 shadow-[10px_10px_0_0_rgba(0,122,255,0.18)]">
        <p class="text-lg leading-relaxed text-gray-800 font-medium mb-16 border-l-4 border-[#007aff] pl-6">{intro}</p>

        {sections.map((sec, idx) => (
          <div class="mt-16 first:mt-0">
            <h2 class="text-sm font-mono font-bold text-[#007aff] uppercase tracking-[0.2em] mb-6 flex items-center">
              <span class="mr-4 text-2xl text-gray-300">{(idx + 1).toString().padStart(2, '0')}</span>
              {sec.heading}
            </h2>
            <div class="space-y-4 pl-10 border-l border-line">
              {sec.body.map(p => (
                <p class="text-base leading-relaxed text-gray-700">{p}</p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>