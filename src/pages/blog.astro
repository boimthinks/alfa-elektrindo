---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getAllData } from '../lib/data';

const { blog } = await getAllData();
const sortedBlog = blog.sort((a, b) => new Date(b.date) - new Date(a.date));

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://alfa.elektrindo.co.id/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://alfa.elektrindo.co.id/blog/" }
  ]
});
---

<Layout title="Blog & Artikel Komponen Elektronik | Alfa Elektrindo" description="Dapatkan informasi terbaru seputar komponen elektronik, industri, dan tips pabrikasi." schema={schema}>
  <PageHeader
    eyebrow={`Ref: ALFA-DOC / INDUSTRIAL-BLOG`}
    title={`Industrial`}
    titleAccent={`Blog`}
    description="Wawasan teknis, berita industri terbaru, dan solusi pengadaan komponen elektronik global."
  >
    <div slot="meta" class="flex flex-wrap gap-x-8 gap-y-3 border-t border-white/10 pt-6 mt-8 font-mono text-[11px] uppercase tracking-widest text-gray-400">
      <span>Articles: <span class="text-white font-bold">{sortedBlog.length}</span></span>
    </div>
  </PageHeader>

  <section class="py-16 bg-paper">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {sortedBlog.map(post => (
          <a href={`/blog/${post.slug}/`} class="overflow-hidden group flex flex-col h-full hover:-translate-y-1 transition-transform duration-300">
            <div class="w-full overflow-hidden bg-gray-100" style="aspect-ratio: 16 / 9;">
              <img
                src={post.fifu_image_url || '/placeholder-blog.png'}
                alt={post.long_title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                style="aspect-ratio: 16 / 9; object-fit: cover;"
                loading="lazy"
              />
            </div>
            <div class="p-5 flex flex-col flex-grow border-t border-divider">
              <p class="text-[10px] font-mono text-gray-400 uppercase tracking-widest mb-3">
                {post.date ? new Date(post.date).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) : 'Article'}
              </p>
              <h3 class="font-mono text-base font-bold text-navy group-hover:text-primary transition-colors line-clamp-2 leading-snug mb-4">
                {post.long_title}
              </h3>
              <div class="mt-auto flex items-center text-[10px] font-mono text-primary font-bold uppercase tracking-widest">
                Read More <span class="ml-2 group-hover:translate-x-2 transition-transform text-base">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>