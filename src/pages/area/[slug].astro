---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getAllData, shuffle } from '../../lib/data';

export async function getStaticPaths() {
  const { area, part, category, manufacturer } = await getAllData();
  return area.map((item) => ({
    params: { slug: item.slug },
    props: { 
      item,
      allPart: part,
      allCategory: category,
      allManufacturer: manufacturer
    },
  }));
}

const { item, allPart, allCategory, allManufacturer } = Astro.props;

const popularCategories = allCategory.slice(0, 10);
const popularManufacturers = allManufacturer.slice(0, 8);
const randomProducts = shuffle(allPart).slice(0, 20);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `Alfa Elektrindo - ${item.title}`,
  "description": `Distributor Komponen Elektronik di ${item.title}. Melayani pengiriman spare part industri dan pabrikasi.`,
  "areaServed": item.title,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": item.title,
    "addressCountry": "ID"
  }
});
---

<Layout title={`Distributor Komponen Elektronik ${item.title} | Alfa Elektrindo`} description={`Supplier dan distributor komponen elektronik industri di ${item.title}. Jual berbagai spare part elektronik pabrikasi dengan pengiriman cepat ke area ${item.title}.`} schema={schema}>
  <PageHeader
    eyebrow={`Ref: ALFA-DOC / AREA`}
    title={`Distributor Komponen`}
    titleAccent={item.title}
    description={`Layanan distribusi spare part elektronik industri dan pabrikasi untuk wilayah ${item.title} dan sekitarnya.`}
  >
    <div slot="meta" class="flex flex-wrap gap-x-8 gap-y-3 border-t border-white/10 pt-6 mt-8 font-mono text-[11px] uppercase tracking-widest text-gray-400">
      <span>Service Area: <span class="text-accent font-bold">{item.title}</span></span>
      <span>Hub: <span class="text-white font-bold">BATAM</span></span>
    </div>
  </PageHeader>

  {item.content && (
    <section class="py-16 bg-white border-b border-divider">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="prose prose-lg prose-blue max-w-none text-gray-600 leading-relaxed font-medium border-l-4 border-primary/20 pl-8" set:html={item.content} />
      </div>
    </section>
  )}

  <section class="py-16 bg-paper">
    <div class="container mx-auto px-4">
      <div class="flex items-center gap-6 mb-10">
        <h2 class="eyebrow text-navy">Kategori Terpopuler di {item.title}</h2>
        <div class="h-px flex-grow bg-divider"></div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
        {popularCategories.map(cat => (
          <a href={`/ca/${cat.slug}`} class="hard-card p-5 group hover:-translate-y-1 transition-transform duration-300">
            <span class="font-mono text-sm font-bold text-navy leading-snug group-hover:text-primary transition-colors block">{cat.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="products" class="py-16 bg-white border-y border-divider">
    <div class="container mx-auto px-4">
      <div class="flex items-center gap-6 mb-10">
        <h2 class="eyebrow text-navy">Produk di Area {item.title}</h2>
        <div class="h-px flex-grow bg-divider"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-5">
        {randomProducts.map(product => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper">
    <div class="container mx-auto px-4">
      <div class="flex items-center gap-6 mb-10">
        <h2 class="eyebrow text-navy">Brand Utama</h2>
        <div class="h-px flex-grow bg-divider"></div>
      </div>
      <div class="flex flex-wrap gap-3">
        {popularManufacturers.map(m => (
          <a href={`/ma/${m.slug}`} class="font-mono text-xs font-bold uppercase tracking-widest text-gray-700 bg-white border border-divider rounded px-5 py-3 hover:border-primary hover:text-primary transition-all shadow-hard">
            {m.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto bg-navy text-white rounded-lg shadow-[10px_10px_0_0_rgba(0,122,255,0.25)] p-10 md:p-16 relative overflow-hidden text-center">
        <div class="absolute inset-0 blueprint-grid opacity-50"></div>
        <div class="relative z-10">
          <span class="eyebrow text-accent mb-4 inline-block">Batam Logistics</span>
          <h2 class="text-3xl md:text-5xl font-mono font-bold uppercase tracking-tight mb-6">Pengiriman Cepat ke {item.title}</h2>
          <p class="text-gray-400 mb-10 max-w-xl mx-auto leading-relaxed font-sans">
            Alfa Elektrindo menjamin keaslian produk dan kecepatan pengiriman untuk operasional industri Anda di {item.title}.
          </p>
          <div class="flex flex-wrap justify-center gap-4 font-mono">
            <a href="https://wa.me/628126826672" class="premium-button bg-[#25D366] text-white text-sm">
              <span class="material-icons-round mr-2 text-xl">chat</span> WhatsApp Chat
            </a>
            <a href="tel:08126826672" class="premium-button bg-white text-navy text-sm">
              <span class="material-icons-round mr-2 text-xl">call</span> 0812-682-6672
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>