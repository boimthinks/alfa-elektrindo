---
import Layout from '../../layouts/Layout.astro';
import { getAllData, shuffle } from '../../lib/api';

export async function getStaticPaths() {
  const { area, part, category, manufacturer } = await getAllData();
  return area.map((item) => ({
    params: { slug: item.slug },
    props: { 
      item,
      allPart: part,
      allCategory: category,
      allManufacturer: manufacturer
    },
  }));
}

const { item, allPart, allCategory, allManufacturer } = Astro.props;

const popularCategories = allCategory.slice(0, 10);
const popularManufacturers = allManufacturer.slice(0, 8);
const randomProducts = shuffle(allPart).slice(0, 20);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": `Alfa Elektrindo - ${item.title}`,
  "description": `Distributor Komponen Elektronik di ${item.title}. Melayani pengiriman spare part industri dan pabrikasi.`,
  "areaServed": item.title,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": item.title,
    "addressCountry": "ID"
  }
});
---

<Layout title={`Distributor Komponen Elektronik ${item.title} | Alfa Elektrindo`} description={`Supplier dan distributor komponen elektronik industri di ${item.title}. Jual berbagai spare part elektronik pabrikasi dengan pengiriman cepat ke area ${item.title}.`} schema={schema}>
  <!-- Hero Section -->
  <section class="relative bg-primary py-24 overflow-hidden">
    <div class="container mx-auto px-4 relative z-10 text-center">
      <div class="max-w-4xl mx-auto">
        <nav class="flex justify-center text-blue-200 text-sm mb-6">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span class="mx-2">/</span>
          <span class="text-white">Area</span>
          <span class="mx-2">/</span>
          <span class="text-white font-medium">{item.title}</span>
        </nav>
        <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 leading-tight">
          Distributor Komponen Elektronik <span class="text-blue-300">{item.title}</span>
        </h1>
        <p class="text-xl text-blue-50 mb-8 leading-relaxed">
          Kami menyediakan berbagai komponen elektronik industri dan pabrikasi untuk wilayah {item.title} dan sekitarnya. Dukungan teknis dan pengiriman cepat untuk kelancaran bisnis Anda.
        </p>
        <a href="#products" class="bg-white text-primary px-8 py-4 rounded-full font-bold hover:shadow-xl transition-all inline-block">
          Cek Produk di {item.title}
        </a>
      </div>
    </div>
    <!-- Background accents -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-white/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-blue-400/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
  </section>

  <!-- Introduction Content -->
  <section class="py-16 bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed" set:html={item.content} />
    </div>
  </section>

  <!-- Popular Categories -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">Kategori Terpopuler di {item.title}</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
        {popularCategories.map(cat => (
          <a href={`/ca/${cat.slug}`} class="bg-white hover:bg-primary hover:text-white p-4 rounded-xl text-center transition-all border border-gray-100 font-medium shadow-sm hover:shadow-md">
            {cat.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Grid -->
  <section id="products" class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Produk Komponen Elektronik {item.title}</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Lihat berbagai pilihan komponen elektronik industri dan spare part pabrikasi yang siap dikirimkan ke alamat Anda di wilayah {item.title}.
        </p>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 mb-12">
        {randomProducts.map(product => (
          <a href={`/part/${product.slug}`} class="group border border-gray-100 rounded-xl overflow-hidden hover:shadow-xl transition-all bg-white flex flex-col h-full">
            <div 
              class="product-image-container group-hover:scale-105 transition-transform duration-300" 
              style={`background-image: url('${product.fifu_image_url || '/placeholder-product.png'}');`}
              role="img"
              aria-label={product.title}
            >
            </div>
            <div class="p-4 flex flex-grow flex-col">
              <h3 class="text-sm font-bold text-gray-900 line-clamp-2 mb-2 group-hover:text-primary transition-colors">{product.title}</h3>
              <p class="text-xs text-gray-500 mt-auto">{product.category} • {product.manufacturer}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center">
        <a href="/latest-products" class="inline-block border-2 border-primary text-primary px-8 py-3 rounded-full font-bold hover:bg-primary hover:text-white transition-all">
          Lihat Semua Produk →
        </a>
      </div>
    </div>
  </section>

  <!-- Popular Manufacturers -->
  <section class="py-16 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">Brand Utama di Area {item.title}</h2>
      <div class="flex flex-wrap justify-center gap-6">
        {popularManufacturers.map(m => (
          <a href={`/ma/${m.slug}`} class="bg-white px-6 py-3 rounded-lg shadow-sm border border-gray-100 hover:shadow-md hover:border-primary transition-all font-semibold text-gray-700">
            {m.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Area CTA -->
  <section class="py-20 bg-primary/5">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-3xl mx-auto bg-white rounded-3xl p-10 shadow-xl border border-primary/10">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">Butuh Pengiriman ke {item.title}?</h2>
        <p class="text-gray-600 text-lg mb-8 leading-relaxed">
          Alfa Elektrindo melayani pengiriman ke seluruh wilayah {item.title} dan sekitarnya. Kami menjamin keaslian produk dan kecepatan pengiriman untuk mendukung operasional industri Anda.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="https://wa.me/628126826672" class="bg-[#25D366] text-white px-10 py-4 rounded-full font-bold hover:shadow-lg transition-all flex items-center gap-2">
            <span>💬 Pesan via WhatsApp</span>
          </a>
          <a href="tel:08126826672" class="bg-primary text-white px-10 py-4 rounded-full font-bold hover:shadow-lg transition-all flex items-center gap-2">
            <span>📞 Hubungi CS Area {item.title}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
