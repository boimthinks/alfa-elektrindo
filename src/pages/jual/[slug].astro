---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getAllData } from '../../lib/data';

export async function getStaticPaths() {
  const { jual } = await getAllData();
  return jual.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<Layout title={`${item.long_title} | Alfa Elektrindo`} description={item.long_title}>
  <PageHeader
    eyebrow={`Ref: ALFA-DOC / SPECIAL-OFFER`}
    title={item.long_title}
  >
    <div slot="meta" class="flex flex-wrap gap-x-8 gap-y-3 border-t border-white/10 pt-6 mt-8 font-mono text-[11px] uppercase tracking-widest text-gray-400">
      <span>Status: <span class="text-accent font-bold">AVAILABLE</span></span>
    </div>
  </PageHeader>

  <section class="py-16 bg-paper">
    <div class="container mx-auto px-4 max-w-4xl">
      {item.fifu_image_url && (
        <div class="hard-card p-6 mb-12">
          <div class="aspect-video overflow-hidden rounded-lg">
            <img src={item.fifu_image_url} alt={item.long_title} class="w-full h-full object-cover" decoding="async" />
          </div>
        </div>
      )}
      <div class="hard-card p-10">
        <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-[1.8]" set:html={item.content} />
      </div>

      <div class="mt-12 bg-navy text-white rounded-lg p-10 text-center relative overflow-hidden">
        <div class="absolute inset-0 blueprint-grid opacity-40"></div>
        <div class="relative z-10">
          <h2 class="eyebrow text-accent mb-4">Dapatkan Harga Terbaik</h2>
          <p class="text-gray-300 mb-8 font-sans leading-relaxed max-w-xl mx-auto">
            Kami menyediakan berbagai pilihan komponen elektronik dengan harga kompetitif. Hubungi tim kami untuk negosiasi dan diskon volume.
          </p>
          <div class="flex flex-wrap justify-center gap-4 font-mono">
            <a href="https://wa.me/628126826672" class="px-6 py-3 rounded bg-[#25D366] text-white font-bold text-xs uppercase tracking-widest shadow-hard">
              Chat WhatsApp
            </a>
            <a href="mailto:mail@elektrindo.co.id" class="px-6 py-3 rounded bg-white text-navy font-bold text-xs uppercase tracking-widest">
              Kirim Email
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>