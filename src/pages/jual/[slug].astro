---
import Layout from '../../layouts/Layout.astro';
import { getAllData } from '../../lib/api';

export async function getStaticPaths() {
  const { jual } = await getAllData();
  return jual.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<Layout title={`${item.long_title} | Alfa Elektrindo`} description={item.long_title}>
  <article class="bg-white">
    <header class="py-16 bg-gray-900 text-white">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-4">
          {item.long_title}
        </h1>
        <div class="h-1 w-24 bg-primary mx-auto"></div>
      </div>
    </header>

    <div class="container mx-auto px-4 py-12 max-w-4xl">
      {item.fifu_image_url && (
        <img src={item.fifu_image_url} alt={item.long_title} class="w-full h-auto rounded-3xl shadow-xl mb-12" />
      )}
      <div class="prose prose-lg prose-blue max-w-none text-gray-700" set:html={item.content} />
      
      <div class="mt-12 bg-blue-50 rounded-2xl p-8 text-center border border-blue-100">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Dapatkan Harga Terbaik</h2>
        <p class="text-gray-600 mb-8">
          Kami menyediakan berbagai pilihan komponen elektronik dengan harga kompetitif. Hubungi tim marketing kami untuk negosiasi dan diskon volume.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="https://wa.me/628126826672" class="bg-primary text-white px-8 py-4 rounded-full font-bold hover:scale-105 transition-all shadow-lg">
            Chat WhatsApp
          </a>
          <a href="mailto:mail@elektrindo.co.id" class="bg-white text-primary border-2 border-primary px-8 py-4 rounded-full font-bold hover:bg-blue-50 transition-all">
            Kirim Email
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>
