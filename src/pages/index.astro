---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getAllData, shuffle } from '../lib/data';

const { part, blog, category, manufacturer } = await getAllData();

const popularCategories = category.slice(0, 10);
const popularManufacturers = manufacturer.slice(0, 8);
const randomProducts = shuffle(part).slice(0, 15);
const latestBlogs = blog
  .sort((a, b) => new Date(b.date) - new Date(a.date))
  .slice(0, 6);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "url": "https://alfa.elektrindo.co.id/",
      "name": "Alfa Elektrindo",
      "description": "Supplier Komponen Elektronik Industri dan Pabrikasi"
    },
    {
      "@type": "LocalBusiness",
      "name": "CV. Alfa Elektrindo",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jln. Jend Sudirman Komp. Ruko Mega Legenda 2 Blok B2 No.7 Baloi Permai",
        "addressLocality": "Batam",
        "addressRegion": "Kepulauan Riau",
        "postalCode": "29431",
        "addressCountry": "ID"
      },
      "telephone": "+628126826672"
    }
  ]
});
---

<Layout title="Supplier Komponen Elektronik Industri #1 | Alfa Elektrindo" schema={schema}>
  <!-- HERO: Blueprint Datasheet Style -->
  <section class="relative bg-navy text-white overflow-hidden py-24 md:py-32">
    <div class="absolute inset-0 blueprint-grid opacity-30"></div>
    <div class="absolute -right-20 -top-20 w-80 h-80 border-2 border-primary/40"></div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl animate-fade-in-up">
        <span class="eyebrow text-accent mb-8 inline-flex items-center gap-3">
          <span class="block w-2 h-2 bg-accent"></span>
          Ref: ALFA-DOC / 2026 · Batam, ID
        </span>
        <h1 class="text-4xl md:text-6xl font-bold font-mono leading-[1.08] mb-10 tracking-tight uppercase">
          Supplier <span class="text-primary">Komponen Elektronik</span><br class="hidden sm:block" />
          Industri & Pabrikasi
        </h1>
        <p class="text-lg md:text-xl text-gray-400 mb-12 leading-relaxed max-w-2xl font-sans">
          Cari dan temukan spare part elektronik yang tepat, termasuk komponen usang yang sulit ditemukan di pasaran global.
        </p>

        <div class="flex flex-wrap gap-4 mb-12 font-mono">
          <a href="#products" class="premium-button bg-white text-navy text-xs hover:bg-accent hover:text-white">
            Eksplorasi Katalog
          </a>
          <a href="https://wa.me/628126826672" class="premium-button bg-transparent border-2 border-gray-500 text-white text-xs hover:bg-primary/20">
            Konsultasi Gratis
          </a>
        </div>

        <div class="flex flex-wrap gap-x-8 gap-y-3 border-t border-white/10 pt-6 font-mono text-[10px] uppercase tracking-widest text-gray-400">
          <span>Items: <span class="text-white font-bold">{part.length}</span></span>
          <span>Kategori: <span class="text-white font-bold">{category.length}</span></span>
          <span>Brand: <span class="text-white font-bold">{manufacturer.length}</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- POPULAR CATEGORIES -->
  <section class="py-20 bg-paper">
    <div class="container mx-auto px-4">
      <div class="flex items-center gap-6 mb-12">
        <h2 class="eyebrow text-navy">Kategori Terpopuler</h2>
        <div class="h-px flex-grow bg-line"></div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
        {popularCategories.map(cat => (
          <a href={`/ca/${cat.slug}`} class="hard-card p-5 group flex flex-col justify-between hover:border-primary transition-colors">
            <span class="block w-2 h-2 bg-primary mb-3"></span>
            <span class="font-mono text-sm font-bold text-navy leading-snug group-hover:text-primary">{cat.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PRODUCT GRID -->
  <section id="products" class="py-20 bg-white border-y border-line">
    <div class="container mx-auto px-4">
      <div class="flex items-center gap-6 mb-12">
        <h2 class="eyebrow text-navy">Produk Unggulan</h2>
        <div class="h-px flex-grow bg-line"></div>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-5">
        {randomProducts.map(product => (
          <ProductCard product={product} />
        ))}
      </div>
      
      <div class="mt-16 text-center">
        <a href="/latest-products" class="eyebrow text-primary hover:text-navy transition-colors">
          Lihat Semua Produk →
        </a>
      </div>
    </div>
  </section>

  <!-- BLOG Section -->
  <section class="py-20 bg-navy text-white relative">
    <div class="absolute inset-0 blueprint-grid opacity-30"></div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="flex items-center gap-6 mb-12">
        <h2 class="eyebrow text-white">Wawasan Industri</h2>
        <div class="h-px flex-grow bg-white/20"></div>
        <a href="/blog" class="eyebrow text-accent hover:text-white">Arsip Blog →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {latestBlogs.map(post => (
          <a href={`/blog/${post.slug}`} class="bg-white/5 border border-line rounded-lg overflow-hidden hover:border-primary transition-all flex flex-col h-full">
            <div class="aspect-[16/9] bg-gray-100">
              <img src={post.fifu_image_url || '/placeholder-blog.png'} alt={post.long_title} class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <p class="font-mono text-[9px] text-gray-400 uppercase tracking-widest mb-3">
                {new Date(post.date).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}
              </p>
              <h3 class="font-mono text-sm font-bold text-white leading-snug mb-4 line-clamp-2">{post.long_title || post.title}</h3>
              <span class="mt-auto font-mono text-[10px] uppercase tracking-widest text-primary">READ MORE</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>