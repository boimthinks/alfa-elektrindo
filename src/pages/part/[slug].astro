---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getAllData } from '../../lib/data';

export async function getStaticPaths() {
  const { part } = await getAllData();
  return part.map((product) => {
    const relatedProducts = part
      .filter(p => p.category === product.category && p.slug !== product.slug)
      .slice(0, 10);
    return {
      params: { slug: product.slug },
      props: { product, relatedProducts },
    };
  });
}

const { product, relatedProducts } = Astro.props;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": product.title,
      "description": `${product.title} ${product.category} by ${product.manufacturer}. Supplier Komponen Elektronik Batam.`,
      "image": product.fifu_image_url,
      "brand": { "@type": "Brand", "name": product.manufacturer },
      "offers": {
        "@type": "Offer",
        "url": Astro.url,
        "availability": "https://schema.org/InStock",
        "price": "0",
        "priceCurrency": "IDR"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://alfa.elektrindo.co.id/" },
        { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://alfa.elektrindo.co.id/products" },
        { "@type": "ListItem", "position": 3, "name": product.category || "Part", "item": `https://alfa.elektrindo.co.id/ca/${(product.category || '').toLowerCase().replace(/[^a-z0-9]+/g, '-')}` },
        { "@type": "ListItem", "position": 4, "name": product.title }
      ]
    }
  ]
});

const metaDescription = `Jual ${product.title} ${product.category} ${product.manufacturer}. Distributor komponen elektronik di Batam, spesifikasi terverifikasi dan stok terupdate. Request quote via WhatsApp.`;
---

<Layout title={`Jual ${product.title} ${product.category} ${product.manufacturer} | Alfa Elektrindo`} description={metaDescription} schema={schema}>
  <PageHeader
    eyebrow={`Ref: ALFA-DOC / PART-SPEC`}
    title={`Jual ${product.title} ${product.category} ${product.manufacturer}`}
    description={`Spesifikasi & distribusi komponen ${product.category} ${product.manufacturer}.`}
  >
    <nav slot="breadcrumb" class="flex text-blue-200 text-[10px] font-mono uppercase tracking-widest mb-6">
      <a href="/" class="hover:text-white">Home</a>
      <span class="mx-3 text-blue-400">/</span>
      <a href="/products" class="hover:text-white">Products</a>
    </nav>
    <div slot="meta" class="flex flex-wrap gap-x-8 gap-y-3 border-t border-white/10 pt-6 mt-8 font-mono text-[11px] uppercase tracking-widest text-gray-400">
      <span>Part No: <span class="text-accent font-bold">{product.title}</span></span>
      <span>Brand: <span class="text-white font-bold">{product.manufacturer}</span></span>
      <span>Category: <span class="text-white font-bold">{product.category}</span></span>
    </div>
  </PageHeader>

  <section class="py-16 bg-paper">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 mb-16 items-start">
        <!-- Image -->
        <div class="hard-card p-8 flex items-center justify-center">
          <div class="product-image-container w-full h-[320px]" style={`background-image: url('${product.fifu_image_url || '/placeholder-product.png'}');`}></div>
        </div>

        <!-- Technical info -->
        <div class="hard-card p-8">
          <h2 class="eyebrow text-navy mb-6 flex items-center gap-3">
            <span class="block w-2 h-2 bg-primary"></span>
            Technical Information
          </h2>
          <div class="divide-y divide-divider">
            <div class="flex items-center justify-between py-4">
              <span class="eyebrow text-gray-400">Part Number</span>
              <span class="font-mono text-sm font-bold text-navy text-right">{product.title}</span>
            </div>
            <div class="flex items-center justify-between py-4">
              <span class="eyebrow text-gray-400">Manufacturer</span>
              <a href={`/ma/${(product.manufacturer || '').toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="font-mono text-sm font-bold text-primary text-right hover:text-primary-dark">{product.manufacturer}</a>
            </div>
            <div class="flex items-center justify-between py-4">
              <span class="eyebrow text-gray-400">Category</span>
              <a href={`/ca/${(product.category || '').toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="font-mono text-sm font-bold text-gray-700 text-right hover:text-primary">{product.category}</a>
            </div>
          </div>

          <div class="mt-8 bg-navy text-white p-8 rounded-lg relative overflow-hidden">
            <div class="absolute inset-0 blueprint-grid opacity-40"></div>
            <div class="relative z-10">
              <h3 class="eyebrow text-accent mb-4">Request Quote</h3>
              <p class="text-gray-300 text-sm mb-6 font-sans leading-relaxed">
                Dapatkan penawaran harga terbaik, stok terupdate, dan estimasi pengiriman cepat.
              </p>
              <div class="flex flex-col gap-3 font-mono">
                <a href={`https://wa.me/628126826672?text=Halo, saya tertarik dengan produk ${product.title} ${product.manufacturer}`} class="w-full flex items-center justify-center gap-2 py-3 rounded bg-[#25D366] text-white font-bold text-xs uppercase tracking-widest shadow-hard">
                  <span class="material-icons-round">chat</span> WhatsApp
                </a>
                <a href={`mailto:mail@elektrindo.co.id?subject=Quote Request: ${product.title} - ${product.manufacturer}`} class="w-full flex items-center justify-center gap-2 py-3 rounded bg-white/10 text-white border border-white/20 font-bold text-xs uppercase tracking-widest">
                  Email Inquiry
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="max-w-4xl mx-auto space-y-16">
        {product.pendahuluan && (
          <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-[1.8] font-medium border-l-4 border-primary/30 pl-6" set:html={product.pendahuluan} />
        )}

        <div>
          <div class="flex items-center gap-6 mb-8">
            <h2 class="eyebrow text-navy">Spesifikasi</h2>
            <div class="h-px flex-grow bg-divider"></div>
          </div>
          <div class="hard-card p-8">
            {product.spesifikasi ? (
              <div class="prose prose-lg prose-blue max-w-none text-gray-700 font-medium" set:html={product.spesifikasi} />
            ) : (
              product.content && <div class="prose prose-lg prose-blue max-w-none text-gray-700 font-medium" set:html={product.content} />
            )}
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
          {product.penjelasan_spesifikasi && (
            <div>
              <h2 class="eyebrow text-navy mb-6">Technical Depth</h2>
              <div class="prose prose-lg prose-blue max-w-none text-gray-600 leading-relaxed font-medium" set:html={product.penjelasan_spesifikasi} />
            </div>
          )}
          {product.aplikasi_dalam_industri && (
            <div>
              <h2 class="eyebrow text-navy mb-6">Industrial Application</h2>
              <div class="prose prose-lg prose-blue max-w-none text-gray-600 leading-relaxed font-medium" set:html={product.aplikasi_dalam_industri} />
            </div>
          )}
        </div>

        {product.penutup && (
          <div class="border border-primary/20 rounded-lg p-8 bg-white">
            <div class="prose prose-lg prose-blue max-w-none text-gray-600 italic font-medium" set:html={product.penutup} />
          </div>
        )}
      </div>

      <!-- Related -->
      {relatedProducts && relatedProducts.length > 0 && (
        <div class="mt-20 pt-16 border-t border-divider">
          <div class="flex items-center gap-6 mb-10">
            <h2 class="eyebrow text-navy">Related: {product.category}</h2>
            <div class="h-px flex-grow bg-divider"></div>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-5">
            {relatedProducts.map(related => (
              <ProductCard product={related} />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>

<style is:global>
  @reference "tailwindcss";
  .prose table {
    @apply w-full my-8 border-collapse rounded-lg overflow-hidden;
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .prose th, .prose td {
    @apply p-4 text-left border-b;
    border-bottom-color: var(--color-divider);
  }
  .prose th {
    @apply bg-gray-50 text-xs font-mono font-bold uppercase tracking-widest text-gray-500;
  }
  .prose td {
    @apply text-sm text-gray-700 font-medium;
  }
</style>