---
import Layout from '../../layouts/Layout.astro';
import { getAllData } from '../../lib/api';

export async function getStaticPaths() {
  const { part } = await getAllData();
  return part.map((product) => {
    const relatedProducts = part
      .filter(p => p.category === product.category && p.slug !== product.slug)
      .slice(0, 10);
    return {
      params: { slug: product.slug },
      props: { product, relatedProducts },
    };
  });
}

const { product, relatedProducts } = Astro.props;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.title,
  "description": `${product.title} ${product.category} by ${product.manufacturer}. Supplier Komponen Elektronik Batam.`,
  "image": product.fifu_image_url,
  "brand": {
    "@type": "Brand",
    "name": product.manufacturer
  },
  "offers": {
    "@type": "Offer",
    "url": Astro.url,
    "availability": "https://schema.org/InStock",
    "price": "0",
    "priceCurrency": "IDR"
  }
});
---

<Layout title={`Jual ${product.title} ${product.category} ${product.manufacturer} | Alfa Elektrindo`} schema={schema}>
  <div class="bg-gray-50 py-12 border-b border-gray-200">
    <div class="container mx-auto px-4">
      <nav class="flex text-sm text-gray-500 mb-6">
        <a href="/" class="hover:text-primary">Home</a>
        <span class="mx-2">/</span>
        <a href="/products" class="hover:text-primary">Products</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900 font-medium truncate">{product.title}</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight">
        Jual {product.title} {product.category} {product.manufacturer}
      </h1>
    </div>
  </div>

  <section class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
        <!-- Image Section -->
        <div class="bg-white rounded-2xl p-6 flex items-center justify-center border border-gray-100 shadow-sm h-fit sticky top-24">
           <div class="product-image-container w-full h-[350px] bg-white" style={`background-image: url('${product.fifu_image_url || '/placeholder-product.png'}'); padding: 20px;`}></div>
        </div>

        <!-- Info Section -->
        <div class="space-y-8">
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-4 text-primary uppercase tracking-wider">Product Info</h2>
            <div class="prose prose-blue max-w-none">
              <table class="w-full text-left border-collapse border border-gray-100 rounded-lg overflow-hidden shadow-sm">
                <tbody class="divide-y divide-gray-100">
                  <tr>
                    <th class="py-3 px-4 bg-gray-50 text-gray-600 font-semibold w-1/3">Part Number</th>
                    <td class="py-3 px-4 text-gray-900 font-bold">{product.title}</td>
                  </tr>
                  <tr>
                    <th class="py-3 px-4 bg-gray-50 text-gray-600 font-semibold">Manufacturer</th>
                    <td class="py-3 px-4 text-primary font-medium">
                      <a href={`/ma/${product.manufacturer.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{product.manufacturer}</a>
                    </td>
                  </tr>
                  <tr>
                    <th class="py-3 px-4 bg-gray-50 text-gray-600 font-semibold">Category</th>
                    <td class="py-3 px-4 text-gray-700">
                      <a href={`/ca/${product.category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{product.category}</a>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="bg-primary border border-primary/20 rounded-2xl p-8 text-white shadow-xl">
            <h3 class="text-2xl font-bold mb-3">Request for Quote</h3>
            <p class="text-blue-100 mb-8 text-lg">Hubungi kami untuk mendapatkan penawaran harga terbaik, ketersediaan stok, dan waktu pengiriman.</p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href={`https://wa.me/628126826672?text=Halo, saya tertarik dengan produk ${product.title} ${product.manufacturer}`} class="flex-1 bg-white text-primary hover:bg-gray-100 text-center py-4 rounded-xl font-bold transition-all shadow-lg flex items-center justify-center gap-2">
                <span>💬 WhatsApp Chat</span>
              </a>
              <a href={`mailto:mail@elektrindo.co.id?subject=Quote Request: ${product.title} - ${product.manufacturer}`} class="flex-1 bg-white/10 hover:bg-white/20 text-white text-center py-4 rounded-xl font-bold transition-all shadow-lg border border-white/30 flex items-center justify-center gap-2">
                <span>✉️ Email Inquiry</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Content Sections -->
      <div class="max-w-4xl mx-auto space-y-16">
        <!-- Pendahuluan -->
        {product.pendahuluan && (
          <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed" set:html={product.pendahuluan} />
        )}

        <!-- Spesifikasi -->
        <div class="space-y-6">
          <h2 class="text-3xl font-bold text-gray-900 border-l-4 border-primary pl-4">Spesifikasi {product.title}</h2>
          {product.spesifikasi ? (
            <div class="prose prose-lg prose-blue max-w-none text-gray-700" set:html={product.spesifikasi} />
          ) : (
            product.content && <div class="prose prose-lg prose-blue max-w-none text-gray-700" set:html={product.content} />
          )}
        </div>

        <!-- Penjelasan Spesifikasi -->
        {product.penjelasan_spesifikasi && (
          <div class="space-y-6">
            <h2 class="text-2xl font-bold text-gray-900">Penjelasan Spesifikasi {product.category} {product.title} {product.manufacturer}</h2>
            <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed" set:html={product.penjelasan_spesifikasi} />
          </div>
        )}

        <!-- Aplikasi -->
        {product.aplikasi_dalam_industri && (
          <div class="space-y-6">
            <h2 class="text-2xl font-bold text-gray-900">Aplikasi {product.category} {product.title} Dalam Industri</h2>
            <div class="prose prose-lg prose-blue max-w-none text-gray-700 leading-relaxed" set:html={product.aplikasi_dalam_industri} />
          </div>
        )}

        <!-- Penutup -->
        {product.penutup && (
          <div class="bg-gray-50 p-8 rounded-2xl border border-gray-100">
            <div class="prose prose-lg prose-blue max-w-none text-gray-700 italic" set:html={product.penutup} />
          </div>
        )}

        <!-- Related Products Section -->
        {relatedProducts && relatedProducts.length > 0 && (
          <div class="mt-20 border-t border-gray-100 pt-16">
            <h2 class="text-2xl font-bold text-gray-900 mb-8">Part Number {product.category} Lainnya</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
              {relatedProducts.map(related => (
                <a href={`/part/${related.slug}`} class="group border border-gray-100 rounded-xl overflow-hidden hover:shadow-xl transition-all bg-white flex flex-col h-full">
                  <div 
                    class="product-image-container group-hover:scale-105 transition-transform duration-300" 
                    style={`background-image: url('${related.fifu_image_url || '/placeholder-product.png'}');`}
                    role="img"
                    aria-label={related.title}
                  >
                  </div>
                  <div class="p-4 flex flex-grow flex-col">
                    <h3 class="text-sm font-bold text-gray-900 line-clamp-2 mb-2 group-hover:text-primary transition-colors">{related.title}</h3>
                    <p class="text-xs text-gray-500 mt-auto">{related.category} • {related.manufacturer}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
</Layout>

<style is:global>
  /* Custom table styling for content from DB */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }
  .prose th, .prose td {
    border: 1px solid #f3f4f6;
    padding: 0.75rem;
    text-align: left;
  }
  .prose th {
    background-color: #f9fafb;
    font-weight: 600;
    color: #4b5563;
  }
</style>
