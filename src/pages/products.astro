---
import Layout from '../layouts/Layout.astro';
import { getAllData } from '../lib/api';

const { category } = await getAllData();
---

<Layout title="Kategori Produk Komponen Elektronik | Alfa Elektrindo" description="Jelajahi berbagai kategori komponen elektronik industri dan pabrikasi.">
  <div class="bg-gray-50 py-16 border-b border-gray-200">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Categories</h1>
      <p class="text-gray-600 max-w-2xl mx-auto">
        Temukan berbagai jenis komponen elektronik yang Anda butuhkan melalui kategori produk kami yang lengkap.
      </p>
    </div>
  </div>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {category.map(cat => (
          <a href={`/ca/${cat.slug}`} class="group p-8 border border-gray-100 rounded-2xl bg-gray-50 hover:bg-white hover:shadow-xl hover:border-primary transition-all text-center">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-primary group-hover:text-white transition-all text-primary">
              <span class="text-2xl">📦</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 group-hover:text-primary transition-colors">{cat.name}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
