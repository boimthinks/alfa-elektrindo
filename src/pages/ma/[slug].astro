---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProductCard from '../../components/ProductCard.astro';
import SeoGenerator from '../../components/SeoGenerator.astro';
import { getAllData } from '../../lib/data';

export async function getStaticPaths() {
  const { manufacturer, part } = await getAllData();
  return manufacturer.map((m) => {
    const products = part.filter(p => p.manufacturer === m.name);
    return {
      params: { slug: m.slug },
      props: { manufacturerName: m.name, products },
    };
  });
}

const { manufacturerName, products } = Astro.props;

const categories = [...new Set(products.map(p => p.category).filter(Boolean))];
const sampleParts = products.slice(0, 6);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://alfa.elektrindo.co.id/" },
        { "@type": "ListItem", "position": 2, "name": "Manufacturers", "item": "https://alfa.elektrindo.co.id/manufacturers/" },
        { "@type": "ListItem", "position": 3, "name": manufacturerName, "item": `https://alfa.elektrindo.co.id/ma/${Astro.params.slug}/` }
      ]
    },
    {
      "@type": "ItemList",
      "name": `Katalog ${manufacturerName}`,
      "numberOfItems": products.length,
      "itemListElement": products.map((p, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": p.title,
        "url": `https://alfa.elektrindo.co.id/part/${p.slug}/`
      }))
    }
  ]
});

const metaDescription = `Distributor komponen elektronik ${manufacturerName} di Batam. Sedia spare part industri, stok terupdate, dan harga kompetitif. Request quote via WhatsApp.`;
---

<Layout title={`Jual Produk ${manufacturerName} di Indonesia | Alfa Elektrindo`} description={metaDescription} schema={schema}>
  <PageHeader
    eyebrow={`Ref: ALFA-DOC / MANUFACTURER`}
    title={`Supplier ${manufacturerName}`}
    titleAccent={'di Indonesia'}
    description={`Koleksi ${products.length} produk ${manufacturerName} untuk kebutuhan industri dan pabrikasi Indonesia.`}
  >
    <nav slot="breadcrumb" class="flex text-blue-200 text-[10px] font-mono uppercase tracking-widest mb-6">
      <a href="/" class="hover:text-white">Home</a>
      <span class="mx-3 text-blue-400">/</span>
      <a href="/manufacturers/" class="hover:text-white">Manufacturers</a>
    </nav>
    <div slot="meta" class="flex flex-wrap gap-x-8 gap-y-3 border-t border-white/10 pt-6 mt-8 font-mono text-[11px] uppercase tracking-widest text-gray-400">
      <span>Total: <span class="text-white font-bold">{products.length}</span></span>
      <span>Kategori: <span class="text-accent font-bold">{categories.length}</span></span>
    </div>
  </PageHeader>

  <section class="py-16 bg-paper">
    <div class="container mx-auto px-4 max-w-4xl">
      <SeoGenerator title={manufacturerName} items={products} type="manufacturer" />
    </div>
  </section>

  <section class="py-20 bg-white border-t border-divider">
    <div class="container mx-auto px-4">
      <div class="flex items-center gap-6 mb-6">
        <h2 class="eyebrow text-navy">Kategori Produk {manufacturerName}</h2>
        <div class="h-px flex-grow bg-divider"></div>
        <span class="eyebrow text-gray-400">{categories.length} Categories</span>
      </div>
      <div class="flex flex-wrap gap-3 mb-14">
        {categories.map(c => (
          <a href={`/ca/${c.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`} class="font-mono text-xs font-bold uppercase tracking-widest text-gray-700 bg-white border border-divider rounded px-4 py-2.5 hover:border-primary hover:text-primary transition-all shadow-hard">
            {c}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-6 mb-6">
        <h2 class="eyebrow text-navy">Contoh Part Number</h2>
        <div class="h-px flex-grow bg-divider"></div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-16">
        {sampleParts.map(p => (
          <a href={`/part/${p.slug}/`} class="hard-card p-4 hover:border-primary transition-colors">
            <span class="font-mono text-xs font-bold text-navy leading-snug block">{p.title}</span>
            <span class="text-[9px] font-mono text-gray-400 uppercase tracking-widest mt-1 block">{p.category}</span>
          </a>
        ))}
      </div>

      <div class="flex items-center gap-6 mb-6">
        <h2 class="eyebrow text-navy">Katalog {manufacturerName}</h2>
        <div class="h-px flex-grow bg-divider"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-5">
        {products.map(product => (
          <ProductCard product={product} />
        ))}
      </div>

      <div class="mt-16 bg-navy text-white rounded-lg p-10 relative overflow-hidden text-center">
        <div class="absolute inset-0 blueprint-grid opacity-40"></div>
        <div class="relative z-10">
          <span class="eyebrow text-accent mb-4 inline-block">Batam Logistics</span>
          <h2 class="text-3xl md:text-4xl font-mono font-bold uppercase tracking-tight mb-6">Butuh Produk {manufacturerName}?</h2>
          <p class="text-gray-400 mb-8 max-w-xl mx-auto font-sans">Hubungi tim kami untuk ketersediaan stok, harga terbaik, dan dukungan teknis.</p>
          <div class="flex flex-wrap justify-center gap-4 font-mono">
            <a href="https://wa.me/628126826672" class="premium-button bg-[#25D366] text-white text-xs">
              <span class="material-icons-round mr-2 text-xl">chat</span> WhatsApp
            </a>
            <a href="tel:08126826672" class="premium-button bg-white text-navy text-xs">
              <span class="material-icons-round mr-2 text-xl">call</span> 0812-682-6672
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>