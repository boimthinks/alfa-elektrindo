---
interface Props {
  eyebrow: string;
  title: string;
  titleAccent?: string;
  description?: string;
}

const { eyebrow, title, titleAccent, description } = Astro.props;
---

<section class="relative bg-navy text-white overflow-hidden">
  <div class="absolute inset-0 blueprint-grid opacity-70"></div>
  <div class="absolute -right-16 -top-16 w-64 h-64 border-2 border-primary/30"></div>
  <div class="absolute right-6 top-6 w-3 h-3 bg-accent"></div>

  <div class="relative z-10 container mx-auto px-4 py-16 md:py-20 animate-fade-in-up">
    {Astro.slots.has('breadcrumb') && <slot name="breadcrumb" />}
    <span class="eyebrow text-accent mb-6 inline-flex items-center gap-3">
      <span class="block w-2 h-2 bg-accent"></span>
      {eyebrow}
    </span>
    <h1 class="text-3xl md:text-5xl font-mono font-bold uppercase tracking-tight mb-6 leading-[1.1]">
      {title}{titleAccent && <> <span class="text-primary">{titleAccent}</span></>}
    </h1>
    {description && (
      <p class="text-gray-400 leading-relaxed max-w-2xl font-sans">{description}</p>
    )}
    <slot name="meta" />
  </div>
</section>